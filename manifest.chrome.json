{
  "manifest_version": 3,
  "name": "SpeedySlate - Manga/Webtoon Auto-Translator",
  "version": "1.3.1",
  "description": "Siêu nhẹ & tối ưu: Dịch truyện tranh tự động (Toonhey, Toonily, nHentai...) bằng PaddleOCR cục bộ và AI API (Gemini, Groq, DeepSeek).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Cài đặt SpeedySlate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "offscreen",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "worker.js",
        "icons/*",
        "*.wasm",
        "*.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
