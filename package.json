{
  "name": "speedyslate",
  "version": "1.3.1",
  "description": "Ultra-lightweight Manga & Webtoon Auto-Translate Extension (Chrome & Firefox)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "version:bump": "python3 scripts/bump_version.py",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "python3 scripts/bump_version.py && npm run build:chrome && npm run build:firefox",
    "package:chrome": "npm run build:chrome && python3 scripts/package.py chrome",
    "package:firefox": "npm run build:firefox && python3 scripts/package.py firefox",
    "package": "npm run build && python3 scripts/package.py all",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:harness": "esbuild test-harness/harness.ts --bundle --format=esm --target=es2022 --outfile=test-harness/harness.bundle.js",
    "test:ocr": "npm run build:harness && python3 -m http.server 8642"
  },
  "keywords": [
    "webextension",
    "manga",
    "translator",
    "paddleocr",
    "webtoon",
    "chrome-extension",
    "firefox-addon"
  ],
  "author": "khanhnkq",
  "license": "MIT",
  "dependencies": {
    "@tabler/icons-webfont": "^3.48.0",
    "onnxruntime-web": "1.31.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/webextension-polyfill": "^0.12.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
