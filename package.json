{
  "name": "speedyslate",
  "version": "1.0.0",
  "description": "Ultra-lightweight Manga/Webtoon Auto-Translate Extension for toonhey.com (Chrome & Firefox)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "package:firefox": "npm run build:firefox && python3 scripts/package-firefox.py",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "webextension",
    "manga",
    "translator",
    "paddleocr",
    "webtoon",
    "chrome-extension",
    "firefox-addon"
  ],
  "author": "khanhnkq",
  "license": "MIT",
  "dependencies": {
    "onnxruntime-web": "^1.21.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/webextension-polyfill": "^0.12.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
